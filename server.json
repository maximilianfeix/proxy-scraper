{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.maximilianfeix/proxy-scraper",
  "title": "proxy-scraper",
  "description": "Free proxies that actually work: verified HTTP/SOCKS proxies, and pages fetched through them",
  "version": "1.17.0",
  "websiteUrl": "https://maximilianfeix.github.io/proxy-scraper/",
  "repository": {
    "url": "https://github.com/maximilianfeix/proxy-scraper",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "proxy-scraper-cli",
      "version": "1.17.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--python",
          "value": ">=3.10",
          "description": "the MCP SDK needs Python 3.10+"
        },
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=2.2,<3",
          "description": "the MCP SDK (the [mcp] extra)"
        }
      ],
      "packageArguments": [
        {
          "type": "named",
          "name": "--mcp",
          "description": "run as an MCP server over stdio"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
